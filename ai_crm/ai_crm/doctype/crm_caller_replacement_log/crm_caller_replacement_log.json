        },
        {
            "fieldname": "date",
            "fieldtype": "Datetime",
            "label": "Transfer Date",
            "reqd": 1
        },
        {
            "fieldname": "done_by",
            "fieldtype": "Link",
            "label": "Done By",
            "options": "User",
            "reqd": 1
        }
    ]
}