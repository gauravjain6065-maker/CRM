{
    "name": "CRM Area",
    "doctype": "DocType",
    "module": "ai_crm",
    "custom": 0,
    "editable_grid": 1,
    "engine": "InnoDB",
    "issingle": 0,
    "istable": 0,
    "permissions": [
        {
            "role": "System Manager",
            "create": 1,
            "delete": 1,
            "email": 1,
            "export": 1,
            "import": 1,
            "print": 1,
            "read": 1,
            "report": 1,
            "share": 1,
            "write": 1
        },
        {
            "role": "CRM Admin",
            "create": 1,
            "delete": 1,
            "email": 1,
            "export": 1,
            "import": 1,
            "print": 1,
            "read": 1,
            "report": 1,
            "share": 1,
            "write": 1
        },
        {
            "role": "CRM Telecaller",
            "create": 0,
            "delete": 0,
            "email": 1,
            "export": 0,
            "import": 0,
            "print": 1,
            "read": 1,
            "report": 0,
            "share": 0,
            "write": 0
        }
    ],
    "fields": [
        {
            "fieldname": "area_name",
            "fieldtype": "Data",
            "label": "Area Name",
            "reqd": 1
        },
        {
            "fieldname": "city",
            "fieldtype": "Data",
            "label": "City",
            "default": "Mumbai"
        },
        {
            "fieldname": "pincode",
            "fieldtype": "Data",
            "label": "Pincode"
        },
        {
            "fieldname": "assigned_default_telecaller",
            "fieldtype": "Link",
            "label": "Assigned Default Telecaller",
            "options": "User"
        },
        {
            "fieldname": "active",
            "fieldtype": "Check",
            "label": "Active",
            "default": 1
        }
    ]
}